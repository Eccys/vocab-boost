# Merriam-Webster API Keys
# Copy this file to .env and fill in your own API keys
# The .env file should be added to .gitignore to prevent exposing your keys

# Dictionary API key
VITE_DICTIONARY_API_KEY=your-dictionary-api-key-here

# Thesaurus API key
VITE_THESAURUS_API_KEY=your-thesaurus-api-key-here

# Note: All environment variables must be prefixed with VITE_ to be accessible in the application 